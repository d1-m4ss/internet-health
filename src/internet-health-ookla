#!/usr/bin/env python3
"""Install the official Ookla Speedtest CLI into the data folder (optional second Speedtest service).

    docker exec -it InternetHealth internet-health-ookla install      # shows the terms, asks for "I ACCEPT", downloads
    docker exec InternetHealth internet-health-ookla status
    docker exec InternetHealth internet-health-ookla remove

The binary is Ookla's proprietary software and is NOT part of the Internet Health image: it is downloaded from Ookla
(install.speedtest.net) only after the user accepts Ookla's terms, and is kept in <data>/ookla, so image updates and a
recreated container keep it. Ookla describes the CLI as being for personal, non-commercial use.
"""
import hashlib
import io
import os
import platform
import shutil
import stat
import sys
import tarfile
import tempfile
import urllib.request
from datetime import datetime, timezone

DATA_DIR = os.path.dirname(os.getenv("DB_PATH", "/data/netprobe.sqlite")) or "/data"
BINARY = os.getenv("SPEEDTEST_OOKLA_PATH", "").strip() or os.path.join(DATA_DIR, "ookla", "speedtest")
ACCEPT_FILE = os.getenv("SPEEDTEST_OOKLA_ACCEPTANCE_FILE", "").strip() or os.path.join(DATA_DIR, "ookla-eula-accepted.txt")
VERSION = "1.2.0"
BASE_URL = os.getenv("OOKLA_DOWNLOAD_BASE", "https://install.speedtest.net/app/cli")
ARCHES = {"x86_64": "x86_64", "amd64": "x86_64", "aarch64": "aarch64", "arm64": "aarch64", "armv7l": "armhf", "armv6l": "armel", "i686": "i386"}
EULA, TERMS, PRIVACY = ("https://www.speedtest.net/about/eula", "https://www.speedtest.net/about/terms",
                        "https://www.speedtest.net/about/privacy")
NOTICE = f"""Ookla Speedtest CLI: optional second Speedtest service for Internet Health

The official Ookla Speedtest CLI is separate, proprietary software of Ookla, LLC. It is not part of Internet Health,
is not covered by its MIT license, and Ookla describes it as being for personal, non-commercial use.

  EULA:          {EULA}
  Terms of Use:  {TERMS}
  Privacy:       {PRIVACY}

Internet Health is independent software, not affiliated with or endorsed by Ookla. Accepting does not give you any
redistribution or commercial-use rights. This helper downloads the binary from Ookla into {os.path.dirname(BINARY)}.
"""


def hand_over(*paths):
    """`docker exec` runs as root, the app as the owner of the data folder: what is created here must belong to that owner."""
    if os.geteuid() != 0:
        return
    owner = os.stat(DATA_DIR)
    for path in paths:
        os.chown(path, owner.st_uid, owner.st_gid)


def accepted():
    value = os.getenv("SPEEDTEST_OOKLA_ACCEPT_LICENSE", "").strip()
    if value.upper() in ("I_ACCEPT", "I ACCEPT") or value.lower() in ("1", "true", "yes", "on"):
        return "the SPEEDTEST_OOKLA_ACCEPT_LICENSE variable"
    try:
        with open(ACCEPT_FILE, encoding="utf-8") as handle:
            if handle.readline().strip() == "I_ACCEPT":
                return ACCEPT_FILE
    except OSError:
        pass
    return None


def record_acceptance():
    os.makedirs(os.path.dirname(ACCEPT_FILE), exist_ok=True)
    old = os.umask(0o077)
    try:
        with open(ACCEPT_FILE, "w", encoding="utf-8") as handle:
            handle.write("I_ACCEPT\naccepted_at_utc=%s\neula=%s\nterms=%s\nprivacy=%s\n"
                         % (datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), EULA, TERMS, PRIVACY))
    finally:
        os.umask(old)
    hand_over(ACCEPT_FILE)
    print("Acceptance recorded in", ACCEPT_FILE)


def installed():
    return os.path.isfile(BINARY) and os.access(BINARY, os.X_OK)


def status():
    if installed():
        print("Ookla Speedtest CLI is installed:", BINARY)
    else:
        print("Ookla Speedtest CLI is not installed (expected at %s)." % BINARY)
    where = accepted()
    print("Terms accepted:", ("yes, by " + where) if where else "no")
    return 0 if installed() and where else 1


def download_url():
    arch = ARCHES.get(platform.machine().lower())
    if arch is None:
        raise SystemExit("Ookla publishes no Speedtest CLI for the architecture %r." % platform.machine())
    return "%s/ookla-speedtest-%s-linux-%s.tgz" % (BASE_URL.rstrip("/"), VERSION, arch)


def extract_binary(payload):
    """The `speedtest` file of the archive; nothing else is written to disk."""
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
        for member in archive.getmembers():
            if member.isfile() and os.path.basename(member.name) == "speedtest" and "/" not in member.name.strip("./"):
                handle = archive.extractfile(member)
                if handle is not None:
                    return handle.read()
    raise SystemExit("The archive does not contain a speedtest binary.")


def install():
    if installed() and accepted():
        status()
        return 0
    if not accepted():
        print(NOTICE)
        if not sys.stdin.isatty():
            print("An interactive terminal is needed to accept. Run with -it, or set SPEEDTEST_OOKLA_ACCEPT_LICENSE=I_ACCEPT"
                  " in the container and run this command again.", file=sys.stderr)
            return 2
        if input("Type exactly I ACCEPT to accept and install: ").strip() != "I ACCEPT":
            print("Not accepted; nothing was installed.")
            return 1
        record_acceptance()
    url = download_url()
    print("Downloading", url)
    request = urllib.request.Request(url, headers={"User-Agent": "internet-health-ookla"})
    with urllib.request.urlopen(request, timeout=60) as response:
        payload = response.read(64 * 1024 * 1024)
    print("Downloaded %d bytes, sha256 %s" % (len(payload), hashlib.sha256(payload).hexdigest()))
    binary = extract_binary(payload)
    os.makedirs(os.path.dirname(BINARY), exist_ok=True)
    handle, temp = tempfile.mkstemp(dir=os.path.dirname(BINARY), prefix=".speedtest-")
    with os.fdopen(handle, "wb") as out:
        out.write(binary)
    os.chmod(temp, os.stat(temp).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    os.replace(temp, BINARY)
    hand_over(os.path.dirname(BINARY), BINARY)
    print("Installed", BINARY)
    print("Choose \"Speedtest by Ookla\" under Speedtest -> Measurement service in the web page.")
    return 0


def remove():
    shutil.rmtree(os.path.dirname(BINARY), ignore_errors=True)
    print("Removed", os.path.dirname(BINARY), "(the recorded acceptance in", ACCEPT_FILE, "is kept; delete it to withdraw).")
    return 0


def main(argv):
    command = argv[1] if len(argv) > 1 else "status"
    if command == "install":
        return install()
    if command == "status":
        return status()
    if command == "remove":
        return remove()
    print(__doc__)
    return 64


if __name__ == "__main__":
    sys.exit(main(sys.argv))
